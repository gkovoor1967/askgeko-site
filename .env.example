# Ask GeKo — local environment template.
#
# Copy this file to ".env" (same folder) and fill in your real key. The .env
# file is gitignored and must NEVER be committed. `netlify dev` loads it
# automatically; for production, set the same variables in the Netlify
# dashboard (Site settings -> Environment variables).

# Your OpenRouter API key (required). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug (optional). Defaults to google/gemini-2.5-flash if left unset.
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Vapi voice callback (callback + webhook functions) ---------------------
# Vapi account API key, the outbound phone-number id, and the assistant id.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Shared secret we require in the x-vapi-secret header on the end-of-call
# webhook. Generate a strong random value (e.g. `openssl rand -base64 32`) and
# set the SAME value in Vapi's server-message settings.
VAPI_WEBHOOK_SECRET=

# --- Callback abuse guards (callback function) ------------------------------
# Comma-separated E.164 calling codes we are willing to dial. Keep this in step
# with the Twilio account's geo permissions — anything outside the list is
# refused before a call is placed, which is what stops toll fraud (IRSF).
# Falls back to the same list if unset. 91=India, 1=US/Canada, 66=Thailand,
# 971=UAE, 966=Saudi Arabia, 44=UK.
ALLOWED_CALLING_CODES=91,1,66,971,966,44
# Optional. Max callbacks placed site-wide in any one hour (default 4) and in
# any one day (default 10). These are the blast radius if a bot gets past
# everything else. The hourly cap was 8 until 14 Sep, when a bot placed seven
# calls in twelve minutes and slipped under it by one.
CALLBACK_HOURLY_CAP=4
CALLBACK_DAILY_CAP=10
# Optional. Hard ceiling on a single call, in seconds (default 420 = 7 min).
# Vapi's own default is 600, and the 13 Sep fraud calls all ran to exactly that
# — the caller played audio down the line to run up per-minute revenue share.
# A genuine intake call is 2-3 minutes, so lower this if you want a tighter cap.
CALLBACK_MAX_CALL_SECONDS=420
# Optional. Allowing "1" above admits the WHOLE North American plan, including
# Caribbean nations Twilio bills as separate countries and treats as separate
# geo permissions — several are classic toll-fraud payout targets. These +1
# area codes are refused anyway. Leave unset to use the built-in list (see
# DEFAULT_BLOCKED_NANP in netlify/functions/callback.mjs); set it to an empty
# value to disable the check entirely.
# BLOCKED_NANP_AREA_CODES=

# --- Zoho CRM (INDIA data centre — accounts.zoho.in / www.zohoapis.in) ------
# From the Zoho API console (Self Client). CLIENT_ID/SECRET are permanent;
# GRANT_CODE is single-use and expires ~10 min — used once by
# scripts/zoho-token-exchange.mjs to mint the long-lived REFRESH_TOKEN.
# The webhook only needs CLIENT_ID, CLIENT_SECRET and REFRESH_TOKEN at runtime.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_GRANT_CODE=
ZOHO_REFRESH_TOKEN=
